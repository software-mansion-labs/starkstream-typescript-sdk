{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declarationDir": "dist",
    "noEmit": false,
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "starkstream/cli": ["./src/cli"],
      "starkstream/config": ["./src/config"],
      "starkstream/core": ["./src/core"],
      "starkstream/rolldown": ["./src/rolldown"],
      "starkstream/types": ["./src/types"],
      "starkstream/hooks": ["./src/hooks"],
      "starkstream/create": ["./src/create"],
      "starkstream/runtime/meta": ["./runtime-meta"],
      "starkstream/runtime": ["./src/runtime"],
      "starkstream/common": ["./src/common"],
      "#starkstream-internal-virtual/*": ["./src/types/virtual/*"]
